{
  "pattern": "rvets",
  "globs": {
    "docs": [
      "docs/**/*.md"
    ],
    "types": [
      "shared/**/*.ts"
    ],
    "config": [
      "server/config.template.json",
      "*.config.*",
      "eslint.config.js"
    ],
    "routes": [
      "server/src/routes/**/*.ts"
    ],
    "components": [
      "client/src/components/**/*.tsx"
    ],
    "tests": [
      "**/*.test.*"
    ],
    "styles": [
      "**/*.css"
    ],
    "context": [
      "CLAUDE.md",
      "docs/AGENT-NOTES.md"
    ],
    "narrative": [
      "docs/SYSTEM.md"
    ],
    "planning": [
      "docs/prd/**/*.md",
      "docs/planning/**/*.md"
    ],
    "schema": [
      "docs/schema-mirror.md",
      "docs/schema-mirror.json"
    ]
  },
  "aliases": {
    "backend": [
      "routes",
      "types"
    ],
    "frontend": [
      "components",
      "styles"
    ],
    "api": [
      "routes",
      "types"
    ]
  },
  "composites": {
    "understand": [
      "context",
      "schema",
      "docs",
      "types",
      "config"
    ],
    "codebase": [
      "routes",
      "components"
    ],
    "full": [
      "*"
    ]
  }
}
